	/// Capacity
	measure 'Port Days' = ```
			
			VAR _MinDate = MIN ( dim_date[date] )
			VAR _MaxDate = MAX ( dim_date[date] )
			VAR _Ports =
			    CALCULATETABLE (
			        VALUES ( dim_station[station_key] ),
			        TREATAS ( VALUES ( dim_site[site_code] ), dim_station[site_code] )
			    )
			RETURN
			    SUMX (
			        _Ports,
			        VAR _FirstSession = CALCULATE ( MIN ( dim_station[first_session_date] ) )
			        VAR _StartInPeriod = MAX ( _FirstSession, _MinDate )
			        RETURN MAX ( 0, INT ( _MaxDate - _StartInPeriod ) + 1 )
			    )
			
			// Port-days: each port counts from its first session, never from the start of the period.// (Finding #1 in the report: the old denominator made late sites look idle.)// dim_station is not filtered by dim_site through the fact table, so TREATAS passes the site filter across.
			
			```
		formatString: 0
		displayFolder: 2 Capacity
		lineageTag: d3f67608-cdab-4cb5-8a57-db665a6dfbf8

		changedProperty = Name

		changedProperty = Description

		changedProperty = DisplayFolder

	measure 'kWh per Port per Day' = DIVIDE ( [Energy kWh], [Port Days] )              // network 33.9 · Webster 62.9
		formatString: 0
		displayFolder: 2 Capacity
		lineageTag: f47d7358-f3ba-4d65-b73c-fe22a9c53fa1

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Utilisation %' = DIVIDE ( [Plugged-in Minutes], [Port Days] * 1440 )     // network 41.1 % · Webster 74.5 %
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Capacity
		lineageTag: ca6989b0-e241-432d-9e6f-7941525b7c58

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Idle Share %' = DIVIDE ( [Idle Minutes], [Plugged-in Minutes] )          // network 19.6 %
		formatString: 0
		displayFolder: 2 Capacity
		lineageTag: fec788fa-85c9-4b13-ad05-74fa7ffc3cc2

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Fault Rate %' = ```
			
			DIVIDE (
			    CALCULATE ( [Sessions], dim_end_reason[is_fault] = TRUE () ),
			    [Sessions]
			)
			
			```
		formatString: 0
		displayFolder: 2 Capacity
