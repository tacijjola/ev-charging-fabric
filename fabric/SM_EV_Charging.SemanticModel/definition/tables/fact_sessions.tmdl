	measure 'Revenue per kWh' = DIVIDE ( [Revenue USD], [Energy kWh] )                // $0.13
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 2 Capacity
		lineageTag: 9d1a9f75-2b34-4e97-a3d8-240ea672dd48

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

	measure 'Site Rank (kWh per Port per Day)' = ```
			
			IF (                                                                      //Ranking with window functions
			    ISINSCOPE ( dim_site[site_name] ),                                   // information function
			    RANK (
			        DENSE,
			        ALLSELECTED ( dim_site[site_name] ),
			        ORDERBY ( [kWh per Port per Day], DESC )
			    )
			)
			
			```
		formatString: 0
		displayFolder: 3 Analysis
		lineageTag: fca16758-d844-404e-b79f-e9033903454e

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Energy kWh Rolling 12M' = ```
			
			CALCULATE (
			    [Energy kWh],                               // Rolling 12-month energy with WINDOW over the month grain
			    WINDOW (
			        -11, REL, 0, REL,
			        ALLSELECTED ( dim_date[year_month_sort] ),
			        ORDERBY ( dim_date[year_month_sort], ASC )
			    )
			)
			
			```
		displayFolder: 3 Analysis
		lineageTag: e810a057-5f3e-485c-9e28-8a681461d5aa

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 1% User Share' = ```
			// Share of sessions taken by the top 1 % of users (report: 31 %) — iterator + TOPN
			VAR _Users =                       
			    FILTER ( VALUES ( dim_user[user_key] ), dim_user[user_key] <> -1 )
			VAR _N = ROUNDDOWN ( COUNTROWS ( _Users ) * 0.01, 0 )
			VAR _TopUsers = TOPN ( _N, _Users, CALCULATE ( [Sessions] ), DESC )
			RETURN
			    DIVIDE (
			        CALCULATE ( [Sessions], _TopUsers ),
			        CALCULATE ( [Sessions], fact_sessions[user_key] <> -1 )
			    )
			
			```
		displayFolder: 3 Analysis
		lineageTag: 469d71a3-1746-458e-ae3b-894b049e01d7

		changedProperty = Name

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Title Site Performance' = ```
			// Guarded dynamic title: states a finding only when the data supports it.
			VAR _Top =
			    TOPN ( 1, ALLSELECTED ( dim_site[site_name] ), [kWh per Port per Day], DESC )
			VAR _TopName = MAXX ( _Top, dim_site[site_name] )
			VAR _TopValue = MAXX ( _Top, [kWh per Port per Day] )
			VAR _Network = CALCULATE ( [kWh per Port per Day], ALLSELECTED ( dim_site ) )
			RETURN
			    IF (
			        COUNTROWS ( ALLSELECTED ( dim_site[site_name] ) ) > 1 && _TopValue > _Network,
			        _TopName & " works hardest per port: "
			            & FORMAT ( _TopValue, "0.0" ) & " kWh per port per day, "
			            & FORMAT ( DIVIDE ( _TopValue, _Network ), "0.0" ) & "× the network",
			        "kWh per port per day by site"
			    )
			
			```
		displayFolder: 4 Titles
		lineageTag: 8f7ed0f9-2e6d-4a16-849f-925cdc0a2fae

		changedProperty = Name

		changedProperty = DisplayFolder

	measure 'Sessions Flagged Negative Idle' = CALCULATE ( [Sessions], fact_sessions[is_duration_anomaly] = TRUE () )
		formatString: 0
		displayFolder: 5 Quality
